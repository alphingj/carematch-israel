# Application
APP_NAME=Carematch Israel
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./carematch.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Module System
MODULES_DIR=modules
MODULE_AUTO_DISCOVER=true
MODULE_HOT_RELOAD=true
MODULE_HEALTH_CHECK_INTERVAL=30

# Admin
ADMIN_EMAILS=alphingj@gmail.com,alphingrowthchannel@gmail.com
DEFAULT_ADMIN_ROLE=admin

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Carematch Israel

# Firebase (for new Firebase Auth integration)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=carematch-israel.firebaseapp.com
FIREBASE_PROJECT_ID=carematch-israel
FIREBASE_STORAGE_BUCKET=carematch-israel.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false