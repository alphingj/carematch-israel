{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the platform, either a caregiver or an Israel resident.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["caregiver", "resident", "admin"] },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "nationality": { "type": "string" },
        "age": { "type": "number" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "drivingLicense": { "type": "boolean" },
        "currentlyWorking": { "type": "boolean" },
        "workRequest": { "type": "string", "enum": ["Permanent", "Reliever", "Register reliever"] },
        "workArea": { "type": "string", "enum": ["1- Tel Aviv", "2- Center", "3- Periphery", "4- All Area"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "name", "phone", "onboardingCompleted", "createdAt"]
    },
    "Job": {
      "title": "Job Posting",
      "description": "A job posting for a caregiver.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "active": { "type": "boolean" },
        "title": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "jobType": { "type": "string" },
        "patientGender": { "type": "string" },
        "patientAge": { "type": "number" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "area": { "type": "string" },
        "livingAtHome": { "type": "string" },
        "pets": { "type": "string" },
        "clearMind": { "type": "boolean" },
        "movement": { "type": "string" },
        "careNeeds": { "type": "string" },
        "contactName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "active", "title", "area", "contactName", "contactPhone", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Job postings."
    }
  }
}
